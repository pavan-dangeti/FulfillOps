# Local development values only. Copy to .env (git-ignored) before `docker compose up`.
# Any real deployment must replace every value with a long random secret.

POSTGRES_PASSWORD=dev-postgres-password
ORDER_DB_PASSWORD=dev-order-db-password
INVENTORY_DB_PASSWORD=dev-inventory-db-password
PAYMENT_DB_PASSWORD=dev-payment-db-password
FULFILMENT_DB_PASSWORD=dev-fulfilment-db-password

# Operator accounts, in Spring's {id}password format. Use {bcrypt} hashes outside local dev
# (and escape each $ in a hash as $$ in this file).
SELLER_PASSWORD={noop}seller-dev-password
CS_PASSWORD={noop}cs-dev-password
OPS_PASSWORD={noop}ops-dev-password
# The CS console signs its read-only ops feed in with the plain form of OPS_PASSWORD.
OPS_FEED_PASSWORD=ops-dev-password

# "demo" loads the demo catalog, orders and warehouses on first start.
SPRING_PROFILES_ACTIVE=demo
