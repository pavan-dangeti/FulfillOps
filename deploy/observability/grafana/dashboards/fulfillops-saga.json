{
  "title": "FulfillOps \u2014 order saga",
  "uid": "fulfillops-saga",
  "tags": [
    "fulfillops",
    "orders",
    "saga"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(jvm_memory_used_bytes, application)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Orders accepted / min",
      "description": "POST /api/orders per minute, per service. order-service is the only one that accepts them.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"order-service\",uri=\"/api/orders\",method=\"POST\"}[1m])) * 60",
          "legendFormat": "accepted/min"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Order creation p99",
      "description": "Time to accept an order and commit it with its reserve command. Not the saga: the saga is async.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"order-service\",uri=\"/api/orders\",method=\"POST\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Outbox backlog",
      "description": "Events written but not yet relayed. A number that climbs and stays up means the relay cannot keep up.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(outbox_unpublished) or vector(0)",
          "legendFormat": "unpublished"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Inbox rows",
      "description": "Events each consumer has applied. A consumer that stops moving is the one to look at.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(inbox_processed_total) or vector(0)",
          "legendFormat": "claimed"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate by service",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\"}[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p50 / p95 / p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\"}[1m])) by (le, application))",
          "legendFormat": "p50 {{service}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\"}[1m])) by (le, application))",
          "legendFormat": "p95 {{service}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\"}[1m])) by (le, application))",
          "legendFormat": "p99 {{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox relay rate",
      "description": "Events published per second, and how many the relay is writing out per drain.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum(rate(outbox_relayed_total[1m])) by (application)",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "Messages waiting per consumer. Rising lag on one service while the others are flat is the signature of a stuck consumer.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum(kafka_consumer_fetch_manager_records_lag) by (consumer)",
          "legendFormat": "{{consumer}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Postgres connections in use",
      "description": "One pool per service against one database. Saturation here is what a throughput ceiling looks like.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (application)",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU used",
      "description": "Process CPU per service. Useful for telling a throughput ceiling from a database one.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum(rate(process_cpu_seconds_total[1m])) by (application)",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ]
}