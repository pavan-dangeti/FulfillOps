{
  "consumer": {
    "name": "seller-dashboard"
  },
  "interactions": [
    {
      "description": "a request for the catalog",
      "pending": false,
      "providerStates": [
        {
          "name": "product SKU-1001 exists with 142 units on hand"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer token"
          ]
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/products"
      },
      "response": {
        "body": {
          "content": [
            {
              "id": "SKU-1001",
              "name": "Wireless Mouse",
              "sku": "SKU-1001",
              "stock": 142,
              "unitPrice": 24.99
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].stock": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].unitPrice": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to add a SKU that already exists",
