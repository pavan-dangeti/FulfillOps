                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/products"
      },
      "response": {
        "status": 409
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to add product SKU-TEST-1",
