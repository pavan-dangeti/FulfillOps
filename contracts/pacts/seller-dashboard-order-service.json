{
  "consumer": {
    "name": "seller-dashboard"
  },
  "interactions": [
    {
      "description": "a request for orders by a seller",
      "pending": false,
      "providerStates": [
        {
          "name": "demo orders exist"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer token"
          ]
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/orders"
      },
      "response": {
        "body": {
          "content": [
            {
              "customerName": "Priya Nair",
              "orderNumber": "ORD-1048",
              "quantity": 2,
              "sku": "SKU-1003",
              "status": "PENDING",
              "total": 90
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].customerName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].orderNumber": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(PENDING|PROCESSING|SHIPPED|DELIVERED|REFUNDED)$"
                }
              ]
            },
            "$[*].total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a seller sign-in with the wrong password",
      "pending": false,
      "providerStates": [
        {
          "name": "account seller with password seller-password and role SELLER"
        }
      ],
      "request": {
        "body": {
          "content": {
            "password": "wrong",
            "username": "seller"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/api/auth/token"
      },
      "response": {
        "status": 401
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a seller signs in",
      "pending": false,
      "providerStates": [
        {
          "name": "account seller with password seller-password and role SELLER"
        }
      ],
      "request": {
        "body": {
          "content": {
            "password": "seller-password",
            "username": "seller"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/api/auth/token"
      },
      "response": {
        "body": {
          "content": {
            "accessToken": "eyJhbGciOiJIUzI1NiJ9.e30.sig",
            "roles": [
              "SELLER"
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.accessToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "order-service"
  }
}