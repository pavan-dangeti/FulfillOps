// Opens FulfillOps in GitHub Codespaces (or any dev-container host) with everything the stack and
// its checks need: Docker inside the container, Java 21 for Maven, Node 22 for the front ends, and
// Python 3 for the ordering harness. Once it is open, one command starts the lot:
//
//   ./scripts/up.sh
{
  "name": "FulfillOps",
  // The plain base image, with Java as a feature: the Java image carries an apt source for Yarn
  // whose signing key no longer verifies, which fails every apt-get update, the Docker feature's
  // included.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/java:1": { "version": "21" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  // The smallest Codespace, which is enough: on 2 CPUs and 8 GB, scripts/measure-host.sh measured
  // a cold build of every image at 321 s and 3.4 GB, a cold start at 213 s, and 4.2 GB at peak
  // through a 1,000-order storm, page cache included. The editor and the two front-end dev servers
  // run beside that. Free allowances are counted in core-hours, so the minimum is also the kindest.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "sudo apt-get update -q && sudo apt-get install -yq python3 && cp -n .env.example .env && (cd seller-dashboard && npm ci) && (cd ops-floor && npm ci)",
  "forwardPorts": [4200, 5174, 3000, 16686],
  "portsAttributes": {
    "4200": { "label": "Seller app", "onAutoForward": "notify" },
    "5174": { "label": "Ops floor (live)", "onAutoForward": "openBrowser" },
    "3000": { "label": "Grafana", "onAutoForward": "silent" },
    "16686": { "label": "Jaeger", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" }
}
